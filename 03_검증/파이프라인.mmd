---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	assess(assess)
	review(review)
	respond(respond)
	execute(execute)
	__end__([<p>__end__</p>]):::last
	__start__ --> assess;
	assess -.-> execute;
	assess -.-> review;
	execute -. &nbsp;end&nbsp; .-> __end__;
	execute -.-> review;
	respond -. &nbsp;end&nbsp; .-> __end__;
	respond -.-> assess;
	respond -.-> execute;
	review --> respond;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
