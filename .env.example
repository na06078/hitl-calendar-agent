# .env로 복사한 뒤 본인 값을 입력합니다. 이 예시에는 실제 인증값을 넣지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_CLIENT_FILE=비공개/구글_클라이언트.json
GOOGLE_TOKEN_FILE=비공개/구글_토큰.json
GOOGLE_CALENDAR_ID=
APP_TIMEZONE=Asia/Seoul
DATA_DIR=data
LLM_CALL_LIMIT=0
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=2500
MAX_REJUDGEMENTS=2
